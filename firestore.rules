rules_version = '2';
// Firebase 콘솔 → Firestore Database → 규칙(Rules)에 붙여 넣고 '게시'
service cloud.firestore {
  match /databases/{database}/documents {
    // 교사 보드: 구글로 로그인한 본인만
    match /boards/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 학생 화면(student.html): 반 코드 + 번호-비밀번호를 알아야 열 수 있음 (목록 보기는 교사만)
    match /classes/{code} {
      function isOwner() {
        return request.auth != null && get(/databases/$(database)/documents/classes/$(code)).data.owner == request.auth.uid;
      }
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      // 아직 비밀번호를 안 정한 학생: 학생이 처음 들어올 때 숫자 4자리를 한 번만 써 넣음 (정한 뒤에는 못 읽음)
      match /claim/{n} {
        allow read, write: if isOwner();
        allow get: if resource == null || !("pin" in resource.data);
        allow update: if !("pin" in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pin", "at"])
          && request.resource.data.pin is string && request.resource.data.pin.matches("^[0-9]{4}$");
      }
      match /kids/{key} {
        allow read, write: if isOwner();
        allow get: if true;
        // 학생은 꾸미기·산 기록만 바꿈 (점수·이름은 못 바꿈, 가진 것·산 기록은 늘리기만)
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["av", "wear", "own", "buys", "kidAt"])
          && request.resource.data.get("own", []).hasAll(resource.data.get("own", []))
          && request.resource.data.get("buys", []).hasAll(resource.data.get("buys", []))
          && request.resource.data.get("buys", []).size() <= 30;
      }
      // 과제: 교사만 내고 지움. 반 코드를 아는 학생은 읽기만
      match /hw/{id} {
        allow read: if true;
        allow write: if isOwner();
        // 학생이 낸 것: 문서 이름이 자기 '번호-비밀번호'(kids 문서가 있어야 함)일 때만 씀. 목록은 교사만
        match /sub/{key} {
          allow read, delete: if isOwner();
          allow get: if true;
          allow create, update: if exists(/databases/$(database)/documents/classes/$(code)/kids/$(key))
            && exists(/databases/$(database)/documents/classes/$(code)/hw/$(id))
            && request.resource.data.keys().hasOnly(["link", "img", "at"])
            && request.resource.data.link is string && request.resource.data.link.size() <= 500
            && (request.resource.data.link == "" || request.resource.data.link.matches("^https?://[^ ]+$"))
            && request.resource.data.img is string && request.resource.data.img.size() <= 900000
            && (request.resource.data.img == "" || request.resource.data.img.matches("^data:image/(jpeg|png|webp);base64,.*"))
            && request.resource.data.at is int;
        }
      }
    }
  }
}
